QWidget#launcher {
    background: #141e1e;
}

QLabel {
    background: transparent;
    color: #eef6f4;
    font: 10pt "Segoe UI";
}

QLabel#connectionTitle {
    font-size: 13pt;
    font-weight: 700;
}

QLabel#settingTitle {
    font-weight: 700;
}

QLabel#detail, QLabel#version, QLabel:disabled {
    color: #a9bfba;
}

QLabel#version {
    font-size: 9pt;
}

QFrame#connectionCard, QFrame#settingsCard {
    background: #1a2727;
    border: 1px solid #314643;
    border-radius: 8px;
}

QFrame#connectionCard[connected="true"] {
    background: #203a32;
    border-color: #3b5c50;
}

QFrame#statusIcon {
    background: #182a26;
    border: 1px solid #3b5c50;
    border-radius: 8px;
}

QFrame#divider {
    background: #314643;
}

QFrame#footer {
    background: #1a2727;
    border-top: 1px solid #314643;
}

QPushButton {
    background: #1a2727;
    border: 1px solid #314643;
    border-radius: 6px;
    color: #eef6f4;
    font-size: 10pt;
    font-family: "Segoe UI";
    font-weight: 600;
    padding: 5px 10px;
    outline: none;
}

QPushButton:hover {
    background: #253734;
}

QPushButton:pressed {
    background: #314643;
}

QPushButton:focus {
    border-color: #8abd9f;
}

QPushButton#openDraftEdge {
    background: #abe2c4;
    border-color: #abe2c4;
    color: #123127;
    padding: 9px 14px;
}

QPushButton#openDraftEdge:hover {
    background: #c4f1d8;
}

QPushButton#openDraftEdge:pressed {
    background: #86c8a6;
}

QPushButton#openDraftEdge:focus {
    border-color: #4b8067;
}

QCheckBox {
    border: 1px solid transparent;
    border-radius: 13px;
    padding: 2px;
    outline: none;
}

QCheckBox:focus {
    border-color: #8abd9f;
}

QCheckBox::indicator {
    width: 38px;
    height: 22px;
    image: url("@ui/switch-off.svg");
}

QCheckBox::indicator:checked {
    image: url("@ui/switch-on.svg");
}

QCheckBox::indicator:disabled {
    image: url("@ui/switch-disabled.svg");
}
